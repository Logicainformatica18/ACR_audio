APP_NAME="ACR Audio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://acr_audio.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=audio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ACR Audio: carpeta de audios.
# Vacía = storage/app/private/audio. Puede ser absoluta (D:\audios) o relativa al proyecto.
AUDIO_STORAGE_PATH=
# Tamaño máximo por archivo subido, en MB (debe ser menor que upload_max_filesize de PHP).
AUDIO_MAX_UPLOAD_MB=250

# ACR Audio: motor de separación (audio-separator).
# Usa comillas SIMPLES en las rutas de Windows.
SEPARATOR_BIN='C:\ruta\a\separador\.venv\Scripts\audio-separator.exe'
SEPARATOR_MODELS_DIR='C:\ruta\a\separador\modelos'
SEPARATOR_MODEL=htdemucs_6s.yaml
SEPARATOR_OUTPUT_FORMAT=FLAC
# Segundos máximos por canción.
SEPARATOR_TIMEOUT=3600

# ACR Audio: motor de acordes (tools/acordes, con su propio entorno de Python).
# Vacías = las del proyecto: tools/acordes/.venv/Scripts/python.exe,
# tools/acordes/acordes.py y tools/acordes/modelos. Comillas SIMPLES en Windows.
CHORDS_PYTHON=
CHORDS_SCRIPT=
CHORDS_MODELS_DIR=
# btc-large (acordes con 7, maj7, m7, dim, sus...) o btc-majmin (solo mayor/menor)
CHORDS_MODEL=btc-large
# Segundos máximos por canción.
CHORDS_TIMEOUT=900
